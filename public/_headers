# Fingerprinted Vite assets — long-lived cache.
# Detach Cache-Control first: Cloudflare combines every matching _headers rule,
# so without this, /* also applies max-age=0, must-revalidate to /assets/*.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# HTML / pretty URLs must revalidate so removals and deploys show up immediately.
# Without a sitewide rule, extensionless paths default to s-maxage=604800.
/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate

# Client-only app routes — keep out of search indexes
/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/quote
  X-Robots-Tag: noindex, nofollow

/quote/*
  X-Robots-Tag: noindex, nofollow
